{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CardSorting/LUMI-JOY/blob/main/agent-flight-test/report-schema-v2.json",
  "title": "HEAV3NS Agent Flight Test report, schema 2",
  "description": "A deterministic harness-conformance report. This schema does not represent a live-model quality score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "reportSchemaVersion",
    "track",
    "provider",
    "startedAt",
    "finishedAt",
    "runtime",
    "source",
    "passed",
    "totalDurationMs",
    "scenarios",
    "summary"
  ],
  "properties": {
    "benchmark": { "const": "HEAV3NS Agent Flight Test" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "reportSchemaVersion": { "const": 2 },
    "track": { "const": "harness-conformance" },
    "provider": { "const": "local-scripted-fixture" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "architecture"],
      "properties": {
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "worktreeDirty", "benchmarkInputsSha256", "benchmarkInputFiles"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "worktreeDirty": { "type": ["boolean", "null"] },
        "benchmarkInputsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "benchmarkInputFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "passed": { "type": "boolean" },
    "totalDurationMs": { "type": "number", "minimum": 0 },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/scenario" }, { "properties": { "id": { "const": "FT-01" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scenario" }, { "properties": { "id": { "const": "FT-02" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scenario" }, { "properties": { "id": { "const": "FT-03" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scenario" }, { "properties": { "id": { "const": "FT-04" } } }] },
        { "allOf": [{ "$ref": "#/$defs/scenario" }, { "properties": { "id": { "const": "FT-05" } } }] }
      ],
      "items": false
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalScenarios", "passedScenarios", "failedScenarios"],
      "properties": {
        "totalScenarios": { "const": 5 },
        "passedScenarios": { "type": "integer", "minimum": 0, "maximum": 5 },
        "failedScenarios": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "passed", "durationMs", "providerRequests", "toolCalls", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^FT-0[1-5]$" },
        "name": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "providerRequests": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  }
}
