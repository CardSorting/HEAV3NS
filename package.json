{
	"name": "heav3ns-vscode",
	"displayName": "HEAV3NS",
	"description": "HEAV3NS is a calm, local-first coding companion with explicit review and provider choice.",
	"version": "13.0.0",
	"icon": "assets/icons/icon.png",
	"workspaces": [
		"."
	],
	"engines": {
		"vscode": "^1.84.0",
		"node": ">=22.12.0"
	},
	"author": {
		"name": "William Andrew Cruz (CardSorting)"
	},
	"license": "Apache-2.0",
	"publisher": "CardSorting",
	"repository": {
		"type": "git",
		"url": "https://github.com/CardSorting/LUMI-VSIX.git"
	},
	"files": [
		"dist",
		"webview-ui/build",
		"assets",
		"walkthrough",
		"README.md",
		"PRODUCT.md",
		"PREFACE.md",
		"SOUL_AND_SKILLS_GUIDE.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"PATENT-NON-AGGRESSION-PLEDGE.md",
		"TRADEMARKS.md",
		"THIRD-PARTY-NOTICES.md",
		"LICENSE-MAP.md",
		"SECURITY.md",
		"CONTRIBUTING.md",
		"DCO"
	],
	"homepage": "https://dietcode.io",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"heav3ns",
		"dietcode",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama"
	],
	"activationEvents": [
		"onView:heav3ns-vscode.SidebarProvider",
		"onLanguage",
		"onUri",
		"onStartupFinished",
		"workspaceContains:evals.env"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"icons": {
			"heav3ns-icon": {
				"description": "HEAV3NS",
				"default": {
					"fontPath": "assets/icons/mira-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "LUMIWalkthrough",
				"title": "Meet HEAV3NS, your calm coding companion",
				"description": "HEAV3NS codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell HEAV3NS what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let HEAV3NS learn your codebase",
						"description": "Point HEAV3NS to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Always Use the Best AI Models",
						"description": "HEAV3NS connects you to supported AI models from providers such as Anthropic, Gemini, OpenAI, and others.",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, or discover new capabilities in the MCP Marketplace.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review HEAV3NS's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "heav3ns-vscode-ActivityBar",
					"title": "HEAV3NS",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"heav3ns-vscode-ActivityBar": [
				{
					"type": "webview",
					"id": "heav3ns-vscode.SidebarProvider",
					"name": "HEAV3NS",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "heav3ns-vscode.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "heav3ns-vscode.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "heav3ns-vscode.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "heav3ns-vscode.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "heav3ns-vscode.joyZoningButtonClicked",
				"title": "JoyZoning Audit",
				"icon": "$(shield)"
			},
			{
				"command": "heav3ns-vscode.joyZoningAudit",
				"title": "Run JoyZoning Audit",
				"category": "HEAV3NS",
				"icon": "$(shield)"
			},
			{
				"command": "dietcode.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "HEAV3NS",
				"when": "dietcode.isDevMode"
			},
			{
				"command": "dietcode.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "HEAV3NS",
				"when": "dietcode.isDevMode"
			},
			{
				"command": "heav3ns-vscode.addToChat",
				"title": "Add to HEAV3NS",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.addTerminalOutputToChat",
				"title": "Add to HEAV3NS",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.generateGitCommitMessage",
				"title": "Generate Commit Message with HEAV3NS",
				"category": "HEAV3NS",
				"icon": "$(heav3ns-icon)"
			},
			{
				"command": "heav3ns-vscode.abortGitCommitMessage",
				"title": "Generate Commit Message with HEAV3NS - Stop",
				"category": "HEAV3NS",
				"icon": "$(debug-stop)"
			},
			{
				"command": "heav3ns-vscode.explainCode",
				"title": "Explain with HEAV3NS",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.improveCode",
				"title": "Improve with HEAV3NS",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with HEAV3NS",
				"category": "HEAV3NS",
				"icon": "$(sparkle)"
			},
			{
				"command": "heav3ns-vscode.jupyterExplainCell",
				"title": "Explain Jupyter Cell with HEAV3NS",
				"category": "HEAV3NS",
				"icon": "$(question)"
			},
			{
				"command": "heav3ns-vscode.jupyterImproveCell",
				"title": "Improve Jupyter Cell with HEAV3NS",
				"category": "HEAV3NS",
				"icon": "$(lightbulb)"
			},
			{
				"command": "heav3ns-vscode.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.runHealthCheck",
				"title": "Check HEAV3NS Installation",
				"category": "HEAV3NS",
				"icon": "$(heart)"
			},
			{
				"command": "heav3ns-vscode.reconstructTaskHistory",
				"title": "Reconstruct Task History",
				"category": "HEAV3NS"
			},
			{
				"command": "heav3ns-vscode.clearCache",
				"title": "Clear Cache & Optimize Storage",
				"category": "HEAV3NS",
				"icon": "$(trash)"
			},
			{
				"command": "dietcode.reviewComment.reply",
				"title": "Reply",
				"category": "HEAV3NS",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "dietcode.reviewComment.addToChat",
				"title": "Add to HEAV3NS Chat",
				"category": "HEAV3NS",
				"icon": "$(link-external)"
			},
			{
				"command": "antigravity.importAntigravitySettings",
				"title": "Import Antigravity Settings",
				"category": "Antigravity"
			},
			{
				"command": "antigravity.importAntigravityExtensions",
				"title": "Import Antigravity Extensions",
				"category": "Antigravity"
			},
			{
				"command": "antigravity.prioritized.chat.open",
				"title": "Open Prioritized Chat",
				"category": "Antigravity"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == dietcode-review && !commentIsEmpty"
			},
			{
				"command": "heav3ns-vscode.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "heav3ns-vscode.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "heav3ns-vscode.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "heav3ns-vscode.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "heav3ns-vscode.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !dietcode.isGeneratingCommit"
				},
				{
					"command": "heav3ns-vscode.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && dietcode.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "heav3ns-vscode.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "heav3ns-vscode.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "heav3ns-vscode.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "heav3ns-vscode.runHealthCheck",
					"title": "HEAV3NS: Check Installation (Health Check)"
				},
				{
					"command": "heav3ns-vscode.generateGitCommitMessage",
					"when": "config.git.enabled && !dietcode.isGeneratingCommit"
				},
				{
					"command": "heav3ns-vscode.abortGitCommitMessage",
					"when": "config.git.enabled && dietcode.isGeneratingCommit"
				},
				{
					"command": "dietcode.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "dietcode.reviewComment.reply",
					"group": "inline",
					"when": "commentController == dietcode-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "dietcode.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == dietcode-review"
				}
			]
		},
		"configuration": {
			"title": "HEAV3NS",
			"properties": {
				"lumi.roadmap.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable auto-rolling ROADMAP.md steering, gates, and checkpoint tools."
				},
				"lumi.roadmap.autoBootstrap": {
					"type": "boolean",
					"default": true,
					"description": "Auto-create ROADMAP.md from workspace evidence when missing."
				},
				"lumi.roadmap.autoBootstrapFill": {
					"type": "boolean",
					"default": true,
					"description": "Apply evidence autofill after bootstrap."
				},
				"lumi.roadmap.blockKanbanOnValidationPending": {
					"type": "boolean",
					"default": true,
					"description": "Block attempt_completion when ROADMAP.md changed since last validate."
				},
				"lumi.roadmap.failClosedCompletionGates": {
					"type": "boolean",
					"default": true,
					"description": "Block attempt_completion when roadmap gate evaluation fails."
				},
				"lumi.allowedInteractiveCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "List of glob/regex command patterns allowed to run interactively/in TTY mode without safety warnings."
				},
				"lumi.commandSanitizerMode": {
					"type": "string",
					"enum": [
						"blocking",
						"advisory",
						"disabled"
					],
					"default": "advisory",
					"description": "Control how potentially interactive terminal commands are validated. 'blocking' rejects execution; 'advisory' permits execution but logs warnings; 'disabled' bypasses check."
				},
				"lumi.storage.maxCheckpointMB": {
					"type": "number",
					"default": 1024,
					"description": "Target storage limit in MB for shadow Git checkpoints before triggering automatic vacuuming and compaction."
				},
				"lumi.storage.autoMaintenance": {
					"type": "boolean",
					"default": true,
					"description": "Enable periodic background storage optimization and shadow Git vacuuming."
				},
				"lumi.storage.maxCacheAgeDays": {
					"type": "number",
					"default": 7,
					"description": "Maximum age in days for temporary cache files before automatic deletion during storage optimization."
				},
				"lumi.storage.maxTaskCount": {
					"type": "number",
					"default": 100,
					"description": "Maximum number of non-favorited tasks retained in history before automatically purging oldest task data."
				}
			}
		}
	},
	"scripts": {
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"legal:check": "npm-run-all -s ip:check provenance:check license:check package:check",
		"ip:check": "node scripts/check-ip-claims.mjs",
		"provenance:check": "node scripts/check-provenance.mjs",
		"license:check": "node scripts/check-licensing.mjs",
		"package:check": "node scripts/check-package-boundary.mjs",
		"dco:check": "node scripts/check-dco.mjs",
		"build": "tsc",
		"test": "npx npm-run-all test:unit test:integration",
		"smoke": "node --import tsx src/index.ts --smoke",
		"benchmark": "node --import tsx src/index.ts --benchmark",
		"baseline:update": "node --import tsx src/index.ts --baseline",
		"guardrail": "node --import tsx scripts/validate-repo.ts",
		"validate:adr": "node --import tsx scripts/validate-adr-workspace.ts",
		"validate:project-knowledge": "node --import tsx scripts/validate-project-knowledge.ts",
		"knowledge:bootstrap": "node --import tsx scripts/validate-project-knowledge.ts --bootstrap",
		"validate:cache": "node --import tsx scripts/validate-prompt-cache.ts",
		"token:add": "node --import tsx scripts/add-token.ts",
		"login": "node --import tsx scripts/login.ts",
		"worker:types": "wrangler types src/worker-configuration.d.ts",
		"worker:types:check": "wrangler types src/worker-configuration.d.ts --check",
		"worker:build": "wrangler deploy --dry-run",
		"start": "node dist/index.js",
		"prepublishOnly": "npm run legal:check && npm run check && npm test && npm run build",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run build:webview && npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"postprotos": "biome format src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"build:blog": "node scripts/build-blog.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "npm run protos && tsc --noEmit --incremental && cd webview-ui && tsc --project tsconfig.app.json --noEmit",
		"lint": "biome lint --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto && npm run check:handler-imports && npm run check:task-lifecycle-boundary",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --changed --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --changed --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"audit:adr": "npx tsx scripts/audit-adr.ts",
		"scaffold:adr": "npx tsx scripts/scaffold-adr.ts",
		"lint:mod": "npx tsx scripts/lint-mod-compliance.ts",
		"export:adr": "npx tsx scripts/export-adr.ts",
		"docs:check-repo": "npm-run-all -p docs:check-agent-links docs:check-agent-branding docs:check-root-readme docs:check-root-readme-links docs:check-docs-readme docs:check-readme-metrics audit:adr export:adr",
		"ci:check-all": "npm-run-all -s check-types lint format -p docs:check-repo roadmap:audit doctor:ci test:doctor",
		"compile:extension": "node esbuild.mjs",
		"ci:build": "npm run protos && npm-run-all -p build:webview compile:extension compile-tests",
		"pretest": "npm run compile && npm run compile-tests && npm run lint",
		"test:integration": "vscode-test",
		"test:unit": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json TS_NODE_PROJECT=./tsconfig.unit-test.json mocha",
		"test:unit:update-snapshots": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json TS_NODE_PROJECT=./tsconfig.unit-test.json UPDATE_SNAPSHOTS=true mocha",
		"benchmark:meow-io": "cross-env TS_NODE_TRANSPILE_ONLY=1 ts-node -P tsconfig.unit-test.json -r tsconfig-paths/register scripts/meow-io-benchmark.ts",
		"roadmap:audit": "cross-env TS_NODE_TRANSPILE_ONLY=1 ts-node -P tsconfig.unit-test.json -r tsconfig-paths/register scripts/roadmap_audit.ts",
		"test:coverage": "vscode-test --coverage",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e:build": "vsce package --allow-package-secrets sendgrid --out dist/e2e.vsix",
		"test:e2e": "playwright install && npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "npx tsx scripts/interactive-playwright.ts",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"package:vsix": "node scripts/package-vscode-vsix.mjs",
		"package:vsix:openvsx": "node scripts/package-openvsx-vsix.mjs",
		"package:vsix:all": "npm run package:vsix && npm run package:vsix:openvsx",
		"doctor": "node scripts/lumi-doctor.mjs",
		"doctor:fix": "node scripts/lumi-doctor.mjs --fix",
		"doctor:ci": "node scripts/lumi-doctor.mjs --ci",
		"doctor:install": "node scripts/lumi-doctor.mjs --install-only",
		"test:doctor": "node --test scripts/vsix-native-deps.test.mjs",
		"check:handler-imports": "node scripts/check-handler-imports.mjs",
		"check:task-lifecycle-boundary": "node scripts/check-task-lifecycle-boundary.mjs",
		"audit:native-deps": "node scripts/lumi-doctor.mjs",
		"setup:openvsx": "node scripts/setup-openvsx-namespace.mjs",
		"publish:vscode": "node scripts/publish-vscode.mjs",
		"publish:vscode:prerelease": "node scripts/publish-vscode.mjs --pre-release",
		"publish:openvsx": "node scripts/publish-openvsx.mjs",
		"publish:openvsx:prerelease": "node scripts/publish-openvsx.mjs --pre-release",
		"publish:all": "npm run publish:vscode && npm run publish:openvsx",
		"publish:all:prerelease": "npm run publish:vscode:prerelease && npm run publish:openvsx:prerelease",
		"publish:marketplace": "npm run publish:all",
		"publish:marketplace:prerelease": "npm run publish:all:prerelease",
		"prepare": "npx husky",
		"docs": "cd docs && npm run dev",
		"docs:check-links": "cd docs && npm run check",
		"docs:check-agent-links": "node scripts/check-agent-docs-links.mjs",
		"docs:check-agent-branding": "node scripts/check-agent-docs-branding.mjs",
		"docs:check-root-readme": "node scripts/check-root-readme.mjs",
		"docs:check-docs-readme": "node scripts/check-docs-readme.mjs",
		"docs:check-all": "npm-run-all docs:check-agent-links docs:check-agent-branding docs:check-root-readme docs:check-root-readme-links docs:check-docs-readme docs:check-readme-metrics docs:check-links",
		"docs:check-readme-metrics": "node scripts/check-readme-metrics.mjs",
