{
  "name": "lumi-joy",
  "version": "1.0.7",
  "description": "Lightning-fast, zero-lag AI coding assistant for TypeScript with instant undo and drag-and-drop customization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "lumi": "dist/index.js",
    "lumi-joy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "PATENT-NON-AGGRESSION-PLEDGE.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "William Andrew Cruz <bozoegg@cardsorting.org>",
  "keywords": [
    "lumi",
    "agent",
    "ai-agent",
    "autonomous-agents",
    "llm",
    "cli",
    "tui",
    "monolith",
    "broccolidb",
    "typescript",
    "codex",
    "anthropic",
    "gemini",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CardSorting/LUMI-JOY.git"
  },
  "homepage": "https://github.com/lumi-agents/lumi-joy#readme",
  "bugs": {
    "url": "https://github.com/lumi-agents/lumi-joy/issues"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx scripts/test-runner.ts",
    "smoke": "node --import tsx src/index.ts --smoke",
    "benchmark": "node --import tsx src/index.ts --benchmark",
    "baseline:update": "node --import tsx src/index.ts --baseline",
    "guardrail": "node --import tsx scripts/validate-repo.ts",
    "validate:adr": "node --import tsx scripts/validate-adr-workspace.ts",
    "validate:cache": "node --import tsx scripts/validate-prompt-cache.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12"
  }
}
