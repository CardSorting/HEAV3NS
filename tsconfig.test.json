{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": false,
		"outDir": "out",
		"sourceMap": true,
		"declaration": false,
		"types": ["node", "mocha", "should"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		".vscode-test",
		"webview-ui",
		"src/test/e2e/**/*",
		"src/test/scenarios/**/*",
		"src/worker.ts",
		"src/worker-configuration.d.ts"
	]
}
